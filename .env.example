# ===== ตั้งค่าร้าน (คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า) =====
PORT=3000
# URL ที่ลูกค้าเข้าเว็บ (ใช้สร้างลิงก์ในอีเมล) ตอนขายจริงต้องเป็น https
# BASE_URL=https://shop.example.com   (ถ้าไม่ใส่ จะใช้ http://localhost:PORT)
SHOP_NAME=อักษรไหว

# ไฟล์ฐานข้อมูล SQLite
DATABASE_FILE=./data/shop.db

# รหัสผ่านหลังบ้าน /admin (ชื่อผู้ใช้คือ admin) ต้องยาวอย่างน้อย 12 ตัวอักษร
ADMIN_PASSWORD=

# secret สำหรับเซ็นลิงก์ดาวน์โหลด (HMAC) สุ่มยาวๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_LINK_SECRET=

# ดาวน์โหลดจากคลัง: ลิงก์ที่เซ็นแล้วใช้ได้กี่นาที, บัญชีหนึ่งโหลดได้กี่ไฟล์ต่อ 24 ชม., ล็อกอินค้างไว้กี่วัน
DOWNLOAD_LINK_MINUTES=10
DOWNLOAD_DAILY_LIMIT=60
SESSION_DAYS=30

# ปรับแต่งแอนิเมชันหลังซื้อ: เรนเดอร์พร้อมกันทั้งร้าน, งานค้างต่อบัญชี, จำกัดครั้งต่อ 24 ชม. (0 = ไม่จำกัด), พื้นที่ต่อบัญชี (MB), ฟอนต์ที่อัปโหลดได้ต่อบัญชี
CUSTOM_CONCURRENCY=1
CUSTOM_MAX_ACTIVE=1
CUSTOM_DAILY_LIMIT=0
CUSTOM_STORAGE_MB=3000
USER_FONT_MAX=20

# ===== การชำระเงิน =====
# mock = โหมดทดสอบ (มีปุ่ม "จำลองจ่ายสำเร็จ")  ตอนขายจริงเปลี่ยนเป็นชื่อ adapter ของ gateway ที่เลือก
PAYMENT_PROVIDER=mock
# secret ที่ใช้ตรวจลายเซ็น webhook (โหมด mock ใช้ค่านี้เซ็นเอง / ของจริงเอามาจากหน้า dashboard ของ gateway)
PAYMENT_WEBHOOK_SECRET=
# ของ gateway จริง (ยังไม่ใช้ในโหมด mock)
PAYMENT_API_KEY=

# ===== อีเมล =====
# console = พิมพ์อีเมลลงหน้าจอ (โหมดทดสอบ)  smtp = ส่งจริง
MAIL_MODE=console
MAIL_FROM="ร้านข้อความไทยเคลื่อนไหว <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
