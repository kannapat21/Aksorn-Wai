# ===== ตั้งค่าร้าน (คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า) =====
PORT=3000
# URL ที่ลูกค้าเข้าเว็บ (ใช้สร้างลิงก์ในอีเมล) ตอนขายจริงต้องเป็น https
# BASE_URL=https://shop.example.com   (ถ้าไม่ใส่ จะใช้ http://localhost:PORT)
SHOP_NAME=อักษรไหว

# ไฟล์ฐานข้อมูล SQLite
DATABASE_FILE=./data/shop.db

# บัญชีแอดมิน: เข้าสู่ระบบที่หน้าเข้าสู่ระบบปกติด้วยอีเมลและรหัสผ่านนี้ แล้วจะมีลิงก์ "หลังบ้าน" ในเมนู
# รหัสผ่านต้องยาวอย่างน้อย 12 ตัวอักษร (แก้ในไฟล์นี้แล้วเปิดร้านใหม่ รหัสจะเปลี่ยนตาม) ก่อนขายจริงให้ตั้งใหม่เป็นรหัสสุ่มยาวๆ
ADMIN_EMAIL=admin@aksornwai.local
ADMIN_PASSWORD=

# secret สำหรับเซ็นลิงก์ดาวน์โหลด (HMAC) สุ่มยาวๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOWNLOAD_LINK_SECRET=

# ดาวน์โหลดจากคลัง: ลิงก์ที่เซ็นแล้วใช้ได้กี่นาที, บัญชีหนึ่งโหลดได้กี่ไฟล์ต่อ 24 ชม., ล็อกอินค้างไว้กี่วัน
DOWNLOAD_LINK_MINUTES=10
DOWNLOAD_DAILY_LIMIT=60
SESSION_DAYS=30

# ปรับแต่งแอนิเมชันหลังซื้อ: เรนเดอร์พร้อมกันทั้งร้าน, งานค้างต่อบัญชี, จำกัดครั้งต่อ 24 ชม. (0 = ไม่จำกัด), พื้นที่ต่อบัญชี (MB), ฟอนต์ที่อัปโหลดได้ต่อบัญชี
CUSTOM_CONCURRENCY=1
CUSTOM_MAX_ACTIVE=1
CUSTOM_DAILY_LIMIT=0
CUSTOM_STORAGE_MB=3000
USER_FONT_MAX=20

# ===== การชำระเงิน =====
# mock = โหมดทดสอบ (มีปุ่ม "จำลองจ่ายสำเร็จ")  ตอนขายจริงเปลี่ยนเป็นชื่อ adapter ของ gateway ที่เลือก
PAYMENT_PROVIDER=mock
# Omise (Opn Payments) · ใช้คีย์ทดสอบ (มี _test_) ก่อนเสมอ คัดลอกจาก dashboard.omise.co → Keys / Webhooks
# แล้วเปลี่ยน PAYMENT_PROVIDER=omise · คีย์จริงใช้ได้เฉพาะ NODE_ENV=production
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
# QR PromptPay หมดอายุกี่นาที
OMISE_QR_MINUTES=15
# 1 = ให้ทุกคนกดปุ่ม "จำลองจ่ายสำเร็จ" ของโหมด mock ได้ (ไม่แนะนำ ค่าเริ่มต้นกดได้เฉพาะแอดมินหรือจากเครื่องร้าน)
MOCK_ALLOW_PUBLIC=0
# secret ที่ใช้ตรวจลายเซ็น webhook (โหมด mock ใช้ค่านี้เซ็นเอง / ของจริงเอามาจากหน้า dashboard ของ gateway)
PAYMENT_WEBHOOK_SECRET=
# ของ gateway จริง (ยังไม่ใช้ในโหมด mock)
PAYMENT_API_KEY=

# ----- โอนเงินแล้วกดยืนยัน (PAYMENT_PROVIDER=manual) -----
# ลูกค้าโอน → กด "ยืนยันการโอนเงิน" (ไม่ต้องแนบสลิป) → แอดมินตรวจในแอปธนาคารแล้วกดอนุมัติที่ /admin/transfers
# PromptPay: เบอร์มือถือ 10 หลัก หรือเลขบัตรประชาชน/เลขผู้เสียภาษี 13 หลัก (QR จะใส่ยอดให้) · และ/หรือใส่บัญชีธนาคาร 3 บรรทัดล่าง
PROMPTPAY_ID=
PROMPTPAY_NAME=
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# ออเดอร์ที่ยังไม่โอน/ถูกปฏิเสธ หมดอายุกี่ชั่วโมง · แจ้งโอนได้กี่ครั้งต่อออเดอร์
MANUAL_EXPIRE_HOURS=24
MANUAL_MAX_CONFIRMS=5
# 1 = บวกเศษสตางค์ไม่ซ้ำต่อออเดอร์ (จับคู่ง่ายแต่ลูกค้าเห็นยอดไม่ตรงราคา) · 0 = ยอดตรงราคาเป๊ะ (ค่าเริ่มต้น) จับคู่ด้วยยอด+เวลาโอน+รหัสอ้างอิง
MANUAL_UNIQUE_SATANG=0

# ===== อีเมล =====
# ไม่ได้ตั้ง SMTP = พิมพ์อีเมลลงหน้าจอ (โหมดทดสอบ) · ใส่ SMTP_HOST/USER/PASS แล้วลบบรรทัด MAIL_MODE = ส่งจริง
# (ใช้กับอีเมลยืนยันการสั่งซื้อ ยืนยันอีเมลตอนสมัคร และลืมรหัสผ่าน) ห้ามใส่รหัสผ่านในโค้ด ใส่ในไฟล์นี้เท่านั้น
MAIL_MODE=console
MAIL_FROM="อักษรไหว <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ===== กันสแปม =====
# คำขอสูงสุดต่อ IP ต่อนาที ทั้งเว็บ (0 = ปิด)
RATE_GLOBAL_PER_MIN=600

# ===== ข้อมูลร้านสำหรับหน้านโยบาย (คืนเงิน / เงื่อนไข / ความเป็นส่วนตัว) =====
# ต้องกรอกก่อนขายจริง และควรให้นักกฎหมายตรวจหน้านโยบายก่อน
LEGAL_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=
# LINE ของร้าน (ไอดี เช่น @aksornwai หรือลิงก์ https://line.me/...) แสดงในหน้า "ติดต่อร้าน"
CONTACT_LINE=
CONTACT_ADDRESS=
TAX_ID=
# ขอคืนเงินได้ภายในกี่วันหลังซื้อ (กรณีไฟล์ใช้ไม่ได้)
REFUND_DAYS=7

# ===== ซับอัตโนมัติ (ลูกค้าอัปคลิป → ร้านถอดเสียงไทย → เบิร์นซับด้วยแบบในคลัง) =====
# ตัวถอดเสียงฟรีในเครื่อง (ติดตั้งครั้งเดียว ดู README หัวข้อ "ซับอัตโนมัติ")
#   auto = mlx-whisper (Mac ชิป Apple) ถ้ามี ไม่งั้น faster-whisper · off = ปิดระบบซับ
SUBTITLE_ENGINE=auto
# ว่าง = ใช้ .venv-stt/bin/python ในโฟลเดอร์ร้านถ้ามี ไม่งั้น python3
SUBTITLE_PYTHON=
# ว่าง = whisper-large-v3-turbo
SUBTITLE_MODEL=
# คลิปใหญ่สุดกี่ MB / ยาวสุดกี่วินาที / อัปได้กี่คลิปต่อบัญชีต่อ 24 ชม. (0 = ไม่จำกัด)
SUBTITLE_MAX_MB=300
SUBTITLE_MAX_SECONDS=180
SUBTITLE_DAILY_LIMIT=5
# ลบคลิปลูกค้า ข้อความซับ และไฟล์ที่ได้ อัตโนมัติหลังกี่ชั่วโมง (ความเป็นส่วนตัว)
SUBTITLE_RETENTION_HOURS=24
